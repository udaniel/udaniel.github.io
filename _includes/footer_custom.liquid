<script>
document.addEventListener("DOMContentLoaded", function() {
  // Find all popover icons
  const popovers = document.querySelectorAll('[data-toggle="popover"]');
  
  popovers.forEach(el => {
    // Add custom hover behavior since Bootstrap JS is disabled
    el.addEventListener('mouseenter', function(e) {
      const content = this.getAttribute('data-content');
      if (!content) return;
      
      // Create a clean tooltip div
      const tooltip = document.createElement('div');
      tooltip.innerText = content;
      
      // Apply clean, visible styling (works on both light and dark themes)
      Object.assign(tooltip.style, {
        position: 'fixed',
        backgroundColor: '#222222',
        color: '#ffffff',
        padding: '6px 12px',
        borderRadius: '4px',
        fontSize: '11px',
        fontWeight: '500',
        fontFamily: 'system-ui, -apple-system, sans-serif',
        zIndex: '999999',
        pointerEvents: 'none',
        boxShadow: '0 4px 12px rgba(0,0,0,0.4)',
        border: '1px solid rgba(255,255,255,0.15)',
        transform: 'translate(-50%, -130%)', // Centered and raised above the icon
        whiteSpace: 'nowrap'
      });
      
      document.body.appendChild(tooltip);
      
      // Calculate viewport coordinates to position it exactly above the icon
      const rect = this.getBoundingClientRect();
      tooltip.style.left = (rect.left + rect.width / 2) + 'px';
      tooltip.style.top = rect.top + 'px';
      
      // Store the tooltip reference on the icon so we can remove it on leave
      this._customTooltip = tooltip;
    });
    
    // Destroy the tooltip when mouse leaves the icon
    el.addEventListener('mouseleave', function() {
      if (this._customTooltip) {
        this._customTooltip.remove();
        this._customTooltip = null;
      }
    });
  });
});
</script>
